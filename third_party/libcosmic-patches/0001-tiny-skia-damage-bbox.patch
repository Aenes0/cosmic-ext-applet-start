+
+/// Damage between two frames, before grouping: what changed layer by layer.
+fn layer_damage(last_layers: &[Layer], layers: &[Layer]) -> Vec<Rectangle> {
+    damage::diff(
+        last_layers,
+        layers,
+        |layer| vec![layer.bounds],
+        Layer::damage,
+    )
+}
+
+/// Groups raw damage inside the logical size and coalesces the result.
+fn settle_damage(damage: Vec<Rectangle>, logical_size: Size) -> Vec<Rectangle> {
+    coalesce_damage(damage::group(damage, Rectangle::with_size(logical_size)))
+}
+
+/// The damage `present` draws for a frame, given the layers of the buffer
+/// being reused (`last_layers`) and the current ones: the layer diff, grouped
+/// inside `logical_size` and coalesced. Empty when nothing changed.
+///
+/// `present` goes through the same two steps, so tests can call this function
+/// to get exactly the rectangles that would be drawn.
+pub fn frame_damage(
+    last_layers: &[Layer],
+    layers: &[Layer],
+    logical_size: Size,
+) -> Vec<Rectangle> {
+    let damage = layer_damage(last_layers, layers);
+
+    if damage.is_empty() {
+        damage
+    } else {
+        settle_damage(damage, logical_size)
+    }
+}
+
+/// Coalesces many damage rectangles into one. With more than two rectangles
+/// every layer would be walked, and the clip mask redone, once per rectangle;
+/// drawing their bounding box once is cheaper. With zero, one or two
+/// rectangles the damage is returned untouched.
+pub fn coalesce_damage(damage: Vec<Rectangle>) -> Vec<Rectangle> {
+    if damage.len() <= 2 {
+        return damage;
+    }
+
+    damage
+        .iter()
+        .copied()
+        .reduce(|union, rectangle| union.union(&rectangle))
+        .into_iter()
+        .collect()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn rect(x: f32, y: f32, width: f32, height: f32) -> Rectangle {
+        Rectangle {
+            x,
+            y,
+            width,
+            height,
+        }
+    }
+
+    fn layer(bounds: Rectangle) -> Layer {
+        Layer {
+            bounds,
+            quads: Vec::new(),
+            primitives: Vec::new(),
+            images: Vec::new(),
+            text: Vec::new(),
+        }
+    }
+
+    #[test]
+    fn coalesce_keeps_zero_one_and_two_rectangles() {
+        assert!(coalesce_damage(Vec::new()).is_empty());
+
+        let one = vec![rect(1.0, 2.0, 3.0, 4.0)];
+        assert_eq!(coalesce_damage(one.clone()), one);
+
+        let two = vec![rect(0.0, 0.0, 5.0, 5.0), rect(100.0, 100.0, 5.0, 5.0)];
+        assert_eq!(coalesce_damage(two.clone()), two);
+    }
+
+    #[test]
+    fn coalesce_returns_the_exact_union_of_three_or_more() {
+        let three = vec![
+            rect(10.0, 20.0, 5.0, 5.0),
+            rect(500.5, 400.0, 10.0, 10.0),
+            rect(-8.0, 300.0, 2.0, 40.0),
+        ];
+        let out = coalesce_damage(three.clone());
+        assert_eq!(out, vec![rect(-8.0, 20.0, 518.5, 390.0)]);
+        for r in &three {
+            assert_eq!(out[0].union(r), out[0], "{r:?} not contained");
+        }
+
+        let five: Vec<_> = (0..5)
+            .map(|i| rect(i as f32 * 50.0, i as f32 * 30.0, 4.0, 4.0))
+            .collect();
+        assert_eq!(coalesce_damage(five), vec![rect(0.0, 0.0, 204.0, 124.0)]);
+    }
+
+    #[test]
+    fn frame_damage_empty_when_layers_are_equal() {
+        let layers = vec![layer(rect(0.0, 0.0, 100.0, 100.0))];
+        let size = Size::new(2000.0, 2000.0);
+        assert!(frame_damage(&layers, &layers, size).is_empty());
+    }
+
+    #[test]
+    fn frame_damage_coalesces_distant_rectangles() {
+        let size = Size::new(2000.0, 2000.0);
+        let removed = vec![
+            layer(rect(0.0, 0.0, 10.0, 10.0)),
+            layer(rect(500.0, 500.0, 10.0, 10.0)),
+            layer(rect(1000.0, 1000.0, 10.0, 10.0)),
+        ];
+        // Three distant layers disappear: `group` keeps three rectangles
+        // (too far apart to merge) and `coalesce_damage` makes them one.
+        let damage = frame_damage(&removed, &[], size);
+        assert_eq!(damage, vec![rect(0.0, 0.0, 1010.0, 1010.0)]);
+
+        // Two distant layers disappear: left as two rectangles.
+        let damage = frame_damage(&removed[..2], &[], size);
+        assert_eq!(damage.len(), 2);
+    }
+
+    #[test]
+    fn frame_damage_clips_to_the_logical_size() {
+        let size = Size::new(100.0, 100.0);
+        let removed = vec![layer(rect(90.0, 90.0, 50.0, 50.0))];
+        let damage = frame_damage(&removed, &[], size);
+        assert_eq!(damage, vec![rect(90.0, 90.0, 10.0, 10.0)]);
+    }
+}
