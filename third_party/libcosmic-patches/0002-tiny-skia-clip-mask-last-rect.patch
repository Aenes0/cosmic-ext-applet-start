+#[cfg(test)]
+mod clip_mask_tests {
+    use super::*;
+
+    /// Deterministic pseudo-random numbers (an LCG), to avoid a new crate.
+    struct Lcg(u64);
+
+    impl Lcg {
+        fn next(&mut self) -> u32 {
+            self.0 = self
+                .0
+                .wrapping_mul(6364136223846793005)
+                .wrapping_add(1442695040888963407);
+            (self.0 >> 32) as u32
+        }
+
+        fn below(&mut self, limit: u32) -> u32 {
+            self.next() % limit.max(1)
+        }
+
+        /// A float in `[low, high)` with a fractional part.
+        fn float(&mut self, low: f32, high: f32) -> f32 {
+            low + (high - low) * (self.next() as f32 / u32::MAX as f32)
+        }
+    }
+
+    fn rect(x: f32, y: f32, width: f32, height: f32) -> Rectangle {
+        Rectangle {
+            x,
+            y,
+            width,
+            height,
+        }
+    }
+
+    /// What a brand new mask holds after the stock `adjust_clip_mask`: a
+    /// zeroed mask plus the fill of `bounds`.
+    fn reference(
+        width: u32,
+        height: u32,
+        bounds: Rectangle,
+    ) -> tiny_skia::Mask {
+        let mut mask = tiny_skia::Mask::new(width, height).unwrap();
+        fill_clip_mask(&mut mask, bounds);
+        mask
+    }
+
+    fn random_rect(rng: &mut Lcg, width: u32, height: u32) -> Rectangle {
+        let (w, h) = (width as f32, height as f32);
+
+        match rng.below(7) {
+            // Integer aligned, inside.
+            0 => rect(
+                rng.below(width) as f32,
+                rng.below(height) as f32,
+                rng.below(width) as f32 + 1.0,
+                rng.below(height) as f32 + 1.0,
+            ),
+            // Fractional, inside.
+            1 => rect(
+                rng.float(0.0, w),
+                rng.float(0.0, h),
+                rng.float(0.1, w),
+                rng.float(0.1, h),
+            ),
+            // Negative origin, sticking out.
+            2 => rect(
+                rng.float(-w, 0.0),
+                rng.float(-h, 0.0),
+                rng.float(0.0, 2.0 * w),
+                rng.float(0.0, 2.0 * h),
+            ),
+            // Entirely outside.
+            3 => rect(
+                w + rng.float(0.0, 100.0),
+                -rng.float(20.0, 100.0),
+                rng.float(1.0, 30.0),
+                rng.float(1.0, 30.0),
+            ),
+            // Zero area.
+            4 => rect(
+                rng.float(0.0, w),
+                rng.float(0.0, h),
+                if rng.below(2) == 0 { 0.0 } else { 5.0 },
+                if rng.below(2) == 0 { 0.0 } else { 5.0 },
+            ),
+            // Huge.
+            5 => rect(-3.0e9, -3.0e9, 6.0e9, 6.0e9),
+            // Sub-pixel.
+            _ => rect(
+                rng.float(0.0, w),
+                rng.float(0.0, h),
+                rng.float(0.0, 1.0),
+                rng.float(0.0, 1.0),
+            ),
+        }
+    }
+
+    #[test]
+    fn matches_a_fresh_mask_plus_stock_fill_for_random_rectangles() {
+        let (width, height) = (64, 48);
+        let mut mask = tiny_skia::Mask::new(width, height).unwrap();
+        let mut rng = Lcg(0x5EED);
+        let mut previous = rect(0.0, 0.0, 1.0, 1.0);
+
+        for step in 0..1500 {
+            // Often repeat the previous rectangle: the early return path.
+            let bounds = if rng.below(3) == 0 {
+                previous
+            } else {
+                random_rect(&mut rng, width, height)
+            };
+
+            adjust_clip_mask(&mut mask, bounds);
+
+            assert!(
+                mask.data() == reference(width, height, bounds).data(),
+                "step {step}: mask differs for {bounds:?}"
+            );
+            previous = bounds;
+        }
+    }
+
+    #[test]
+    fn refills_when_the_mask_was_recreated_at_the_same_address() {
+        let (width, height) = (64, 48);
+        let mut mask = tiny_skia::Mask::new(width, height).unwrap();
+        let bounds = rect(10.0, 10.0, 20.0, 15.0);
+
+        adjust_clip_mask(&mut mask, bounds);
+        assert!(mask.data() == reference(width, height, bounds).data());
+
+        // `configure_surface` replaces the mask with a zeroed one, which the
+        // allocator can place at the same address with the same size.
+        mask.data_mut().fill(0);
+        adjust_clip_mask(&mut mask, bounds);
+
+        assert!(
+            mask.data() == reference(width, height, bounds).data(),
+            "the repeated rectangle was not painted on the recreated mask"
+        );
+        assert_eq!(mask.data()[20 * width as usize + 20], 255);
+    }
+
+    #[test]
+    fn keeps_many_masks_independent_and_forgets_the_oldest() {
+        let (width, height) = (16, 12);
+        let mut masks: Vec<_> = (0..3 * MAX_TRACKED_MASKS)
+            .map(|_| tiny_skia::Mask::new(width, height).unwrap())
+            .collect();
+        let mut rng = Lcg(42);
+
+        for round in 0..20 {
+            for (index, mask) in masks.iter_mut().enumerate() {
+                let bounds = random_rect(&mut rng, width, height);
+                adjust_clip_mask(mask, bounds);
+
+                assert!(
+                    mask.data() == reference(width, height, bounds).data(),
+                    "round {round}, mask {index}: differs for {bounds:?}"
+                );
+            }
+        }
+
+        let tracked = LAST_CLIPS.with(|clips| clips.borrow().len());
+        assert!(tracked <= MAX_TRACKED_MASKS, "{tracked} entries kept");
+    }
+
+    #[test]
+    fn rectangles_tiny_skia_rejects_leave_an_empty_mask() {
+        let (width, height) = (32, 24);
+        let mut mask = tiny_skia::Mask::new(width, height).unwrap();
+
+        for bounds in [
+            rect(f32::NAN, 0.0, 5.0, 5.0),
+            rect(4.0, 4.0, -5.0, 5.0),
+            rect(4.0, 4.0, 5.0, f32::INFINITY),
+        ] {
+            adjust_clip_mask(&mut mask, rect(2.0, 2.0, 10.0, 10.0));
+            assert_eq!(mask.data()[3 * width as usize + 3], 255);
+
+            adjust_clip_mask(&mut mask, bounds);
+            assert!(
+                mask.data().iter().all(|&value| value == 0),
+                "{bounds:?} left pixels in the mask"
+            );
+        }
+    }
+
+    #[test]
+    fn clearing_never_slices_outside_the_mask() {
+        let mut mask = tiny_skia::Mask::new(8, 8).unwrap();
+        let outside = PixelRegion {
+            x0: 20,
+            y0: 30,
+            x1: 5,
+            y1: 90,
+        };
+
+        clear_region(&mut mask, outside);
+        assert!(!center_is_set(&mask, outside));
+
+        let covering =
+            PixelRegion::covering(rect(-5.0, 3.0, 1.0e12, 1.0), 8, 8);
+        assert!(covering.x0 <= covering.x1 && covering.x1 <= 8);
+        assert!(covering.y0 <= covering.y1 && covering.y1 <= 8);
+    }
+}
