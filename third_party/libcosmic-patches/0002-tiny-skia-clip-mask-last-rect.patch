+/// How many clip masks are remembered at once. Windows have one mask each,
+/// and `screenshot` creates a short-lived one per call, so a few entries are
+/// plenty; the oldest is forgotten first (which only costs a full clear).
+const MAX_TRACKED_MASKS: usize = 8;
+
+/// Identifies a mask by the address of its pixels and its size.
+#[derive(Clone, Copy, PartialEq, Eq)]
+struct MaskKey {
+    ptr: usize,
+    width: u32,
+    height: u32,
+}
+
+/// Half-open pixel region `x0..x1` by `y0..y1`, always inside the mask.
+#[derive(Clone, Copy, PartialEq, Eq)]
+struct PixelRegion {
+    x0: u32,
+    y0: u32,
+    x1: u32,
+    y1: u32,
+}
+
+impl PixelRegion {
+    /// The pixels `bounds` can touch, clamped to a `width` by `height` mask.
+    fn covering(bounds: Rectangle, width: u32, height: u32) -> Self {
+        // `as u32` saturates, and maps NaN to zero.
+        let x1 =
+            (((bounds.x + bounds.width).ceil().max(0.0)) as u32).min(width);
+        let y1 =
+            (((bounds.y + bounds.height).ceil().max(0.0)) as u32).min(height);
+        let x0 = ((bounds.x.floor().max(0.0)) as u32).min(x1);
+        let y0 = ((bounds.y.floor().max(0.0)) as u32).min(y1);
+
+        Self { x0, y0, x1, y1 }
+    }
+
+    fn is_empty(&self) -> bool {
+        self.x0 >= self.x1 || self.y0 >= self.y1
+    }
+
+    fn center(&self) -> (u32, u32) {
+        ((self.x0 + self.x1) / 2, (self.y0 + self.y1) / 2)
+    }
+}
+
+/// The last rectangle painted on a mask.
+#[derive(Clone, Copy)]
+struct LastClip {
+    key: MaskKey,
+    bounds: [f32; 4],
+    region: PixelRegion,
+}
+
+thread_local! {
+    static LAST_CLIPS: std::cell::RefCell<Vec<LastClip>> =
+        const { std::cell::RefCell::new(Vec::new()) };
+}
+
+/// Stores `last` as the latest clip of its mask and returns the previous one.
+fn replace_last_clip(last: LastClip) -> Option<LastClip> {
+    LAST_CLIPS
+        .try_with(|clips| {
+            let mut clips = clips.borrow_mut();
+
+            if let Some(entry) =
+                clips.iter_mut().find(|entry| entry.key == last.key)
+            {
+                return Some(std::mem::replace(entry, last));
+            }
+
+            if clips.len() >= MAX_TRACKED_MASKS {
+                let _oldest = clips.remove(0);
+            }
+            clips.push(last);
+
+            None
+        })
+        .ok()
+        .flatten()
+}
+
+/// Whether the pixel at the centre of `region` is set, i.e. the mask still
+/// holds the fill of that region. Fills are not anti-aliased: a pixel is
+/// either 0 or 255.
+fn center_is_set(clip_mask: &tiny_skia::Mask, region: PixelRegion) -> bool {
+    let (x, y) = region.center();
+    let width = clip_mask.width() as usize;
+
+    clip_mask
+        .data()
+        .get(y as usize * width + x as usize)
+        .is_some_and(|&value| value == 255)
+}
+
+/// Zeroes the pixels of `region` only.
+fn clear_region(clip_mask: &mut tiny_skia::Mask, region: PixelRegion) {
+    let width = clip_mask.width() as usize;
+    let height = clip_mask.height() as usize;
+    let x1 = (region.x1 as usize).min(width);
+    let x0 = (region.x0 as usize).min(x1);
+    let y1 = (region.y1 as usize).min(height);
+    let y0 = (region.y0 as usize).min(y1);
+
+    for row in clip_mask
+        .data_mut()
+        .chunks_exact_mut(width.max(1))
+        .skip(y0)
+        .take(y1 - y0)
+    {
+        if let Some(pixels) = row.get_mut(x0..x1) {
+            pixels.fill(0);
+        }
+    }
+}
+
+/// Makes `clip_mask` hold exactly the (not anti-aliased) fill of `bounds`.
+///
+/// The mask is the same one as in the previous call most of the time, and
